{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "CarMaintenance.Api": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=CarMaintenanceDb;Trusted_Connection=true;MultipleActiveResultSets=true"
  },
  "JWT": {
    "Secret": "ThisIsAVeryLongAndSecureKeyForJWTTokenGenerationThatShouldBeAtLeast256BitsLong!",
    "ValidIssuer": "CarMaintenance.Api",
    "ValidAudience": "CarMaintenance.Client",
    "ExpirationMinutes": 60
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "DefaultExpiration": 60
  },
  "SignalR": {
    "EnableDetailedErrors": true,
    "ServerTimeout": 300
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200",
      "http://localhost:3000",
      "https://localhost:3000"
    ]
  },
  "Cache": {
    "DefaultExpirationMinutes": 60,
    "SlidingExpiration": true,
    "CacheSizeLimit": 1000
  },
  "ML": {
    "ModelPath": "Models/",
    "PredictionConfidenceThreshold": 0.7,
    "TrainingDataRefreshIntervalHours": 24
  },
  "Notifications": {
    "EnableEmailNotifications": true,
    "EnableSignalRNotifications": true,
    "MaintenanceReminderDays": 7,
    "ServiceOverdueDays": 1
  },
  "FileUpload": {
    "MaxFileSize": 10485760,
    "AllowedExtensions": [".jpg", ".jpeg", ".png", ".pdf", ".doc", ".docx"],
    "UploadPath": "Uploads/"
  }
}