# ============================

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# .NET dependencies
**/bin/
**/obj/
*.user
*.suo
*.userprefs
**/packages/
**/project.lock.json
**/.paket/paket.exe
**/.paket/paket.targets
**/.paket/paket.dependencies

# Flutter dependencies
**/android/**/gradle-wrapper.jar
**/.gradle/
**/ios/**/Flutter.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/GeneratedPluginRegistrant.m
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*
**/android/**/local.properties
**/android/.gradle/
**/ios/.symlinks/
**/ios/Debug-iphoneos/
**/ios/Debug-iphonesimulator/
**/ios/Release-iphoneos/
**/ios/Release-iphonesimulator/
**/macos/Flutter/GeneratedPluginRegistrant.swift

