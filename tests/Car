using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Logging;
using Microsoft.Extensions.Hosting;
using Microsoft.AspNetCore.Mvc.Testing;
using CarMaintenance.Api;
using CarMaintenance.Api.Data;
using CarMaintenance.Domain.Entities;
using MediatR;
using CarMaintenance.Application.Commands;
using CarMaintenance.Application.DTOs;
using FluentValidation;
using Xunit;
using Xunit.Abstractions;
using Microsoft.AspNetCore.Mvc;

namespace CarMaintenance.Tests.Integration;

/// <summary>
/// Integration test base class with test database setup
/// </summary>
public abstract class IntegrationTestBase : IClassFixture<WebApplicationFactory<Program>>, IAsyncLifetime
{
    protected readonly WebApplicationFactory<Program> Factory;
    protected readonly ITestOutputHelper Output;
    protected readonly HttpClient Client;
    protected AppDbContext Context => Factory.Services.GetRequiredService<AppDbContext>();
    protected IServiceProvider Services => Factory.Services;

    protected IntegrationTestBase(WebApplicationFactory<Program> factory, ITestOutputHelper output)
    {
        Output = output;
        Factory = factory.WithWebHostBuilder(builder =>
        {
            builder.UseEnvironment("Testing");
            builder.ConfigureLogging(logging =>
            {
                logging.ClearProviders();
                logging.AddXUnit(output);
                logging.SetMinimumLevel(LogLevel.Debug);
            });
        });

        Client = Factory.CreateClient();
    }

    public async Task InitializeAsync()
    {
        await EnsureDatabaseCreated();
        await SeedTestData();
    }

    public async Task DisposeAsync()
    {
        await CleanDatabase();
        Client.Dispose();
    }

    private async Task EnsureDatabaseCreated()
    {
        await Context.Database.EnsureCreatedAsync();
    }

    private async Task SeedTestData()
    {
        // Create test service types
        var oilChange = new ServiceType
        {
            Id = 1,
            Name = "Oil Change",
            Description = "Regular engine oil change",
            RecommendedIntervalMiles = 5000,
            RecommendedIntervalMonths = 6,
            AverageCost = 50.00m,
            IsActive = true
        };

        var brakeInspection = new ServiceType
        {
            Id = 2,
            Name = "Brake Inspection",
            Description = "Check brake pads and system",
            RecommendedIntervalMiles = 12000,
            RecommendedIntervalMonths = 12,
            AverageCost = 100.00m,
            IsActive = true
        };

        Context.ServiceTypes.AddRange(oilChange, brakeInspection);

        // Create test owner
        var testOwner = new Owner
        {
            Id = 1,
            FirstName = "John",
            LastName = "Doe",
            Email = "john.doe@test.com",
            Phone = "+1234567890",
            IsActive = true
        };

        Context.Owners.Add(testOwner);

        await Context.SaveChangesAsync();
    }

    private async Task CleanDatabase()
    {
        await Context.Database.EnsureDeletedAsync();
    }

    protected async Task<TResponse> SendRequestAsync<TResponse>(IRequest<TResponse> request)
    {
        var mediator = Services.GetRequiredService<IMediator>();
        return await mediator.Send(request);
    }

    protected async Task<HttpResponseMessage> PostAsync(string requestUri, object content)
    {
        return await Client.PostAsJsonAsync(requestUri, content);
    }

    protected async Task<HttpResponseMessage> GetAsync(string requestUri)
    {
        return await Client.GetAsync(requestUri);
    }

    protected async Task<HttpResponseMessage> PutAsync(string requestUri, object content)
    {
        return await Client.PutAsJsonAsync(requestUri, content);
    }

    protected async Task<HttpResponseMessage> DeleteAsync(string requestUri)
    {
        return await Client.DeleteAsync(requestUri);
    }

    protected async Task<T?> GetContentAsync<T>(HttpResponseMessage response)
    {
        var json = await response.Content.ReadAsStringAsync();
        return System.Text.Json.JsonSerializer.Deserialize<T>(json);
    }

    protected void WriteLine(string message)
    {
        Output.WriteLine(message);
    }
}